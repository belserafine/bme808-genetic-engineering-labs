### QUESTION 2
# use first_atg_idx as a startloc to look for stop codon
# stop codon = TAG, TGA, TAA
# ORF must be at least 99 nucleotides, otherwise reject
# if long enough, print position of start and stop codons
# must find all ORFs that are long enuf
# when ORF is long enough, continue search after stop codon
# when ORF is too short, continue search after start codon to avoid overlapping ORFs

print("\nQUESTION 2")

i = 0
count_orfs = 0
SHORTEST = 99

while i < len(seq):
    # find ATG from current position i
    atg = find_pattern("ATG", seq, i, len(seq), 1,3)

    # exit loop if no more ATGs or ORFs in the seq
    if atg == -1:
        break

    # find index of stop codon after current ATG
    tag = find_pattern("TAG", seq, atg+3, len(seq), 3,3)
    tga = find_pattern("TGA", seq, atg+3, len(seq), 3, 3)
    taa = find_pattern("TAA", seq, atg+3, len(seq), 3, 3)

    stop_candidates = [tag, tga, taa]

    # remove candidates if stop codon not found
    for j in stop_candidates[:]:
        if j == -1:
            stop_candidates.remove(j)

    # if none of the candidates were found, then set stop as -1
    if not stop_candidates:
        stop = -1
    else:
        stop = min(stop_candidates)

    orf_length = stop - atg

    # add 1 to ORF count if current orf is of sufficient length
    if orf_length >= SHORTEST:
        count_orfs += 1
        print("ORF#", count_orfs,"ATG =", atg, "STOP =", stop)

        # shift by a codon after stop to look for next ORF after this ORF
        i = stop + 3

    # if length not met, shift by a codon after current start codon to look for next ORF
    else:
        i = atg + 3


