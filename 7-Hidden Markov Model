def q3(eseq):

    M = 2 # states
    N = len(eseq)

    # initialize viterbi matrix
    viterbi = [[0 for j in range(N)] for i in range(M)]

    # initialize backtracking matrix
    back = [[0 for j in range(N)] for i in range(M)]

    # set first column
    for i in range(M):
        viterbi[i][0] = initial[i] * emission[eseq[0]][i]

    # set remaining columns
    for j in range(1, N): # skip 0
        for i in range(M):
            max_t = -1
            best_k = 0

            # find max transition and keep track of pointer
            for k in range(M):
                curr_t = viterbi[k][j-1] * transition[k][i]
                if curr_t > max_t:
                    max_t = curr_t
                    best_k = k

            viterbi[i][j] = emission[eseq[j]][i] * max_t
            back[i][j] = best_k

    # find best final state and prob
    best_last_state = 0
    best_last_prob = 0

    for i in range(M):
        if viterbi[i][N-1] > best_last_prob:
            best_last_prob = viterbi[i][N-1]
            best_last_state = i

    # backtrack
    path = [0 for _ in range(N)] # initialize path array
    path[N-1] = best_last_state # set last state

    for j in range(N-1, 0, -1): # iterate backward
        # starting at last state in path
        path[j-1] = back[path[j]][j]

    ''' only used to check
    print("Viterbi matrix:")
    for row in viterbi:
        print(row)

    print("Backpointer matrix:")
    for row in back:
        print(row)
    '''

    named_path = [state_names[s] for s in path]

    print("Most likely state sequence:", named_path, f"with probability {best_last_prob:.3e}.")

if __name__ == "__main__":
    q3(eseq1)
