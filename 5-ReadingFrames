# function to find a pattern within a search text
def find_pattern(pattern, search_text, start_loc, stop_loc, increment, threshold):
    pattern_len = len(pattern)
    text_len = len(search_text)

    # from start loc to stop loc (and allow space for length of pattern)
    # increment shifts starting index of the reading frame
    for i in range(start_loc, stop_loc - pattern_len + 1, increment):
        count = 0
        j = i

        # count number of matching characters at this location i
        for k in range(0, pattern_len):
            if search_text[j] == pattern[k]:
                count += 1
            j += 1

        # check if the number of matched characters is enough
        if count >= threshold:
            return i # return location of pattern in search text

    return -1 # pattern not found

