def takesequence(f):
    with open(f, "r") as file: # open the file and read it
        seq = ""
        content = file.read() # read entire file into content
        lines = content.split("\n") # split file contents by line
        lines = lines[1:]
        for line in lines:
            seq += line
        return seq

def count_nucleotides(sequence):
    print("How many total nucleotides are in the sequence?", len(sequence))
    print("How many A, C, G, and T nucleotides are in the sequence?")
    a_count = sequence.count("A")
    c_count = sequence.count("C")
    g_count = sequence.count("G")
    t_count = sequence.count("T")
    print(f"    A: {a_count}, C: {c_count}, G: {g_count}, T: {t_count}")
    return a_count, c_count, g_count, t_count

