# check condition: whether GC content in the window are >= 0.55
def check_window_gc_content(seq, win_size):
    # length of sequence
    len_seq = len(seq)

    # computing GC content for each window
    for i in range(0, len_seq - win_size + 1): # slide window until end of sequence
        # looking at nucleotides in current window
        curr_window = seq[i : i + win_size]

        # compute GC content in current window
        curr_GC = (curr_window.count('G') + curr_window.count('C')) / win_size
        # print(curr_GC) # used to check GC content, last one is 0.54

        # if current GC content does not meet threshold, then condition is not met
        if curr_GC < 0.55:
            return "No"

    # if all GC contents meet threshold, then condition is met
    return "Yes"

