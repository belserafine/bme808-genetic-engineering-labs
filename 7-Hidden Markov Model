states = [0, 1] # fair, loaded
state_names = ["Fair", "Loaded"]
initial = [0.5, 0.5] # fair, loaded
emission = [
    [1/6,  1/6,  1/6,  1/6,  1/6,  1/6], # given fair state
    [1/10, 1/10, 1/10, 1/10, 1/10, 1/2]  # given loaded state
]
emission = [list(row) for row in zip(*emission)] # transpose
transition = [
    [0.99, 0.01], # FF, FL
    [0.20, 0.80]  # LF, LL
]

eseq1 = [2, 5, 3]
eseq2 = [2,2,2,2,2,2,2,5,5,5,5,5]

def q1(eseq):

    # storage
    pmax = 0.0
    sseq = []

    # nested for loop to create all 8 possible state sequences
    for s0 in states:
        for s1 in states:
            for s2 in states:
                curr_state_seq = [s0, s1, s2]

                # compute probability for current state seq
                probability = (
                        initial[s0] * emission[eseq[0]][s0] *
                        transition[s0][s1] * emission[eseq[1]][s1] *
                        transition[s1][s2] * emission[eseq[2]][s2]
                )

                # find maximum probability and corresponding seq
                if probability > pmax:
                    pmax = probability
                    sseq = curr_state_seq

    sseq = [state_names[s] for s in sseq]

    print('The most likely sequence to generate [2,5,3] is', sseq,
          'which has probability', round(pmax,5))

