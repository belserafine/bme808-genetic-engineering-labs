def longestoverlap(s1,s2):
    # get length of s1 and s2 (number of characters in the string)
    l1 = len(s1)
    l2 = len(s2)
    # find the lower value between the two, which give us
    # the number of characters in the shorter sequence
    n = min(l1,l2)

    # while the shorter length is greater than 0
    while n > 0:
        # check if suffix of s1 (suffix starts from (l1-n)th character until end of s1)
        # matches prefix of s2 (start of s2 up to nth character)
        if s1[l1 - n:l1] == s2[0:n]:
            # if true, return the now_node value of n, which is the number of largest overlap
            return n
        # otherwise, subtract 1 from n, to shorten the overlap and repeat the comparison
        n=n-1
    # if no matches found, the longest overlap is 0
    return 0

