def count_cxt(sequence):
    cat_count = 0
    cct_count = 0
    cgt_count = 0
    cxt_count = 0

    for i in range(0, len(sequence) - 2, 3): #ensure doesnt include last 2 nucleotides as an incomplete codon
        codon = sequence[i:i + 3]
        if codon == "CAT":
            cat_count += 1
            cxt_count += 1
        elif codon == "CCT":
            cct_count += 1
            cxt_count += 1
        elif codon == "CGT":
            cgt_count += 1
            cxt_count += 1
        elif codon == "CTT":
            cxt_count += 1

    print("CAT: ", cat_count)
    print("CCT: ", cct_count)
    print("CGT: ", cgt_count)
    print("CXT: ", cxt_count)
    return cat_count, cct_count, cgt_count, cxt_count

