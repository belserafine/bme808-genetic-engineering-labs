# function to print sequence length, overall gc content, cpg dimers, overall cpg ratio
# optionally returns cpg ratio array for win_size
def get_cpg_data(seq, win_size = 0):
    # length of sequence
    len_seq = len(seq)

    # overall GC content
    seq_GC = (seq.count('G') + seq.count('C')) / len_seq

    # number of CpG dimers
    seq_cpg_dimers= seq.count('CG')

    # overall CpG ratio for entire sequence
    seq_cpg_ratio = (seq.count('CG') * len_seq) / (seq.count('C') * seq.count('G'))

    # print information
    print('length of sequence =', len_seq,
          '\nOverall GC content =', round(seq_GC, 3),
          '\nNumber of CpG Dimers =', seq_cpg_dimers,
          '\nOverall CpG ratio for the entire sequence =', round(seq_cpg_ratio, 3))

    if win_size == 0:
        return 0

    else:
        # initialize window size and cpg ratios array
        seq_cpg_ratios = [0] * (len_seq - win_size + 1)

        # computing cpg ratios for each window
        for i in range(0, len_seq - win_size + 1): # slide window until end of sequence
            curr_window = seq[i : i + win_size] # looking at nucleotides in current window

            # if no G or C is present, cpg ratio is 0
            if curr_window.count('G') == 0 or curr_window.count('C') == 0:
                seq_cpg_ratios[i] = 0.0
                continue

            # otherwise, compute cpg ratio and assign to array
            else:
                curr_cpg_ratio = (curr_window.count('CG') * win_size) / (curr_window.count('G') * curr_window.count('C'))
                seq_cpg_ratios[i] = round(curr_cpg_ratio,3)

        # return ratio array
        return seq_cpg_ratios

