def mode_aa(protein):
    return statistics.mode(protein)

def mode_aa_count_codon(sequence, protein):
    aa = mode_aa(protein) #get mode aa

    # list codons that can translate to mode aa
    codons = []
    for key, value in codontab.items():
        if value == aa:
            codons.append(key)
    # print(codons) #to check
    unique_codons = set()
    for i in range(0, len(sequence) - 2, 3):
        codon = sequence[i:i + 3]
        if codon in codons:
            unique_codons.add(codon)
    return len(unique_codons)

