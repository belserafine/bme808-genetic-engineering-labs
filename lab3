def greedy(matrix):
    matrix = matrix.copy() # avoid destroying original

    # initialize path array
    path = np.zeros(n)

    for i in range(n):
        largest_overlap = 0
        max_j = 0

        # find max j in row i
        for j in range(n):
            if matrix[i][j] > largest_overlap:
                largest_overlap = matrix[i][j]
                max_j = j

        # if nothing found, set -1
        if max_j == 0:
            path[i] = -1
            continue

        # choose index of largest overlap as now_node path successor
        path[i] = max_j

        # zero out row i except chosen column
        for k in range(n):
            if k == max_j:
                continue
            matrix[i][k] = 0

        # zero out column max_j except chosen row
        for k in range(n):
            if k == i:
                continue
            matrix[k][max_j] = 0
    return path, matrix

