### Needleman-Wunsch Algorithm
# as outlined in Exploring Bioinformatics, p. 54
# Goal: Determine the optimal global alignment of two sequences
# Input: Two sequences
# Output: Best, global alignment(s) of two input sequences

# Function to create directional string
def buildDirectionalString(matrix, N, M) :
    dstring = ""
    currentRow = N
    currentCol = M

    while currentRow != 0 or currentCol != 0: # loop while we are not at matrix[0][0]

        if currentRow == 0:
            dstring = dstring + "H" # gap in first sequence
            currentCol -= 1 # go left

        elif currentCol == 0:
            dstring = dstring + "V" # gap in second sequence
            currentRow -= 1 # go up

        # check left
        elif matrix[currentRow][currentCol-1] + gap == matrix[currentRow][currentCol]:
            dstring = dstring + "H"
            currentCol -= 1 # go left

        # check up
        elif matrix[currentRow-1][currentCol] + gap == matrix[currentRow][currentCol]:
            dstring = dstring + "V"
            currentRow -= 1 # go up

        # otherwise it has to be diagonal
        else:
            dstring = dstring + "D"
            currentCol -= 1
            currentRow -= 1
    return dstring

